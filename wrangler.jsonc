// Configuração do Cloudflare Worker. Explicação de cada campo no DEPLOY.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ehzra-hub",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ehzra-hub",
      "database_id": "4f2187d2-4726-47af-b0d3-98993d549330",
      "migrations_dir": "worker/migrations"
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://billowing-tree-6cb9.cloudflareaccess.com",
    "POLICY_AUD": "55e75deb6a84b8fc2e2578dfd32f5695d03091ba1a03fdfa689b5e486b9257c7"
  },
  "observability": { "enabled": true }
}
